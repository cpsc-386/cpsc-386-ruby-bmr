#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "bmr"

def main
  age = ARGV[0].to_f
  inches = ARGV[1].to_f
  pounds = ARGV[2].to_f
  sex = ARGV[3]
  subject = BMR::Person.new(age, inches, pounds, sex)
  puts subject
  puts "#{BMR.mifflin_st_jeor(subject).round(2)} calories"
  0
end

exit(main)
